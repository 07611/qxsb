# ─────────────────────────────────────────────────────────────
# Moodwave · 环境变量样例。复制为 .env 后按需修改。
# 严禁把 .env 提交到版本库；所有密钥只从环境变量读取。
# ─────────────────────────────────────────────────────────────

# 应用
APP_NAME=Moodwave
APP_ENV=development
DEBUG=true
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:8000
COOKIE_SECURE=false
TRUST_PROXY=false
AUTO_SEED=true

# 安全密钥：生产环境必须替换为至少 64 位随机字符串
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-64-char-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# 数据库与媒体
DATABASE_URL=sqlite:///./backend/data/moodwave.db
MEDIA_ROOT=./backend/media
MAX_IMAGE_MB=5
MAX_VIDEO_MB=50

# 演示账号（仅 seed 使用；首次登录后请在个人中心修改）
SEED_ADMIN_EMAIL=admin@moodwave.app
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=demo@moodwave.app
SEED_USER_PASSWORD=Demo@12345

# 注册审核 / 邀请码
REGISTRATION_REQUIRE_INVITE=false
REGISTRATION_REQUIRE_APPROVAL=false

# 可选 Redis（生产多实例限流）；留空使用 SQLite 原子计数
REDIS_URL=

# SMTP 邮件（留空时写入 backend/logs/email-outbox，仅本地开发）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Moodwave <no-reply@moodwave.app>
SMTP_TLS=true
DEV_MAILBOX=true

# 第三方 OAuth（未配置的渠道不显示登录入口）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000

# 本地签名直传；有效时间会被限制在 10 分钟内
PRESIGN_EXPIRE_SECONDS=600

# 在线歌曲（iTunes Search API 无需密钥）
ENABLE_ONLINE_MUSIC=true
JAMENDO_CLIENT_ID=

# 观测与告警
SENTRY_DSN=
ALERT_WEBHOOK_URL=
# 可选真实推送 / 短信通道 webhook；未配置时本地模拟成功并写任务日志
PUSH_WEBHOOK_URL=
SMS_WEBHOOK_URL=
LOG_LEVEL=INFO

# 仅 DEBUG=true 时，忘记密码响应可返回本地重置链接，生产必须关闭
EXPOSE_DEV_RESET_LINK=true
